{
  "name": "@lcj/server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Servidor de licencias y panel admin de La comida justa (Cloudflare Workers + D1).",
  "scripts": {
    "dev": "wrangler dev --env dev",
    "db:migrate:local": "wrangler d1 migrations apply lcj-licencias --local --env dev",
    "db:migrate:remote": "wrangler d1 migrations apply lcj-licencias --remote",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lcj/shared": "*",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "esbuild": "^0.28.0",
    "miniflare": "^4.20260730.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.40.0"
  }
}
