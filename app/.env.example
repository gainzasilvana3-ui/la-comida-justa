# Copiá a .env.local para desarrollo (o generalo con `npm run keys:dev` desde la raíz).
# En Cloudflare Pages se cargan en Settings → Environment variables.
# URL del servidor de licencias (sin barra final)
VITE_API_BASE=https://licencias.tudominio.com
# Clave PÚBLICA para verificar autorizaciones (no es secreta). La genera server/scripts/generate-keys.mjs
VITE_LICENSE_PUBLIC_KEY={"kty":"EC","crv":"P-256","x":"...","y":"..."}
# Clave de sitio de Cloudflare Turnstile (pública)
VITE_TURNSTILE_SITE_KEY=
# Contacto de soporte que se muestra en la app (mail o WhatsApp)
VITE_SUPPORT_CONTACT=
